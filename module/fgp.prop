# The original 2016 Pixel (non-XL) on its August 2018 build.
# Values match the real sailfish factory image's system build.prop (Pixel, PPR1.180610.009).

# Build Fields
MANUFACTURER=Google
MODEL=Pixel
FINGERPRINT=google/sailfish/sailfish:9/PPR1.180610.009/4898911:user/release-keys
BRAND=google
PRODUCT=sailfish
DEVICE=sailfish
HARDWARE=marlin
BOARD=sailfish
RELEASE=9
SDK=28
ID=PPR1.180610.009
DISPLAY=PPR1.180610.009
INCREMENTAL=4898911
TYPE=user
TAGS=release-keys
SECURITY_PATCH=2018-08-05
DEVICE_INITIAL_SDK_INT=25

# System Properties
*.build.id=PPR1.180610.009
*.security_patch=2018-08-05
*api_level=25

# Feature Overrides
com.google.android.feature.PIXEL_EXPERIENCE=true
com.google.android.feature.GOOGLE_BUILD=true
com.google.android.feature.GOOGLE_EXPERIENCE=true
com.google.android.apps.photos.NEXUS_PRELOAD=true
com.google.android.apps.photos.PIXEL_PRELOAD=true
com.google.android.apps.photos.PIXEL_2016_PRELOAD=true

# Advanced Settings
spoofBuild=1
spoofProps=0
spoofProvider=0
spoofSignature=0
spoofFeatures=1
verboseLogs=0
